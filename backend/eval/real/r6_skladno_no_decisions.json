    {
      "start_sec": 422.2,
      "speaker": null,
      "text": "Здесь, где-то, сколько?"
    },
    {
      "start_sec": 423.2,
      "speaker": null,
      "text": "Ну, вообще, коммерческий отдел 24 на 7 работает."
