    {
      "start_sec": 368.2,
      "speaker": null,
      "text": "Вернее не боксы."
    },
    {
      "start_sec": 370.2,
      "speaker": null,
      "text": "Не корректно."
    },
    {
      "start_sec": 371.2,
      "speaker": null,
      "text": "Ящики более большие."
