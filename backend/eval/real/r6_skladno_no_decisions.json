    {
      "start_sec": 396.2,
      "speaker": null,
      "text": "Я считаю, что это очень важно,"
    },
    {
      "start_sec": 399.2,
      "speaker": null,
      "text": "что каждый проект отрисовывается отдельно."
    },
    {
      "start_sec": 402.2,
      "speaker": null,
      "text": "Максимально у нас проект на отделу делает огромное внимание,"
    },
    {
      "start_sec": 406.2,
      "speaker": null,
      "text": "на самом деле проект."
    },
    {
      "start_sec": 407.2,
      "speaker": null,
      "text": "Проект на отдел вот здесь, где-то сидит, да?"
    },
    {
      "start_sec": 409.2,
      "speaker": null,
      "text": "Да, не чуть дальше."
    },
    {
      "start_sec": 410.2,
      "speaker": null,
      "text": "Так, это кто пришел."
    },
    {
      "start_sec": 411.2,
      "speaker": null,
      "text": "А это все сейчас, кто приходит,"
    },
    {
      "start_sec": 412.2,
      "speaker": null,
      "text": "все, где-то действительно, должны были приходить?"
