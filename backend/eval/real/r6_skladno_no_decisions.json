    {
      "start_sec": 434.2,
      "speaker": null,
      "text": "Так, я считаю, что мы сейчас подготовим."
    },
    {
      "start_sec": 436.2,
      "speaker": null,
      "text": "Вот какой-то такой ударный текст,"
