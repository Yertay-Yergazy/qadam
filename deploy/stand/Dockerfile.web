# Static frontend + /api proxy (TLS is done by the host's Caddy). Built with: --build-context stand=deploy/stand
FROM --platform=$BUILDPLATFORM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=stand nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
