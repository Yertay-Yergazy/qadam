# --- audio calls (LiveKit). Leave the key empty to run without calls (upload-only mode).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=qadam-dev-secret-change-me-0123456789abcdef
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880

# --- speech-to-text (faster-whisper)
WHISPER_MODEL=small        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu         # cpu | cuda
WHISPER_COMPUTE_TYPE=int8  # int8 for CPU, float16 for GPU
WHISPER_LANGUAGE=          # empty = auto-detect; or ru / kk / en

# --- NLP step: placeholder = rules, llm = self-hosted model (falls back to rules), none = no drafts
DRAFTER=placeholder
# LLM drafter (DRAFTER=llm): any OpenAI-compatible server. llama.cpp: http://localhost:8080/v1, Ollama: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen             # llama-server ignores it; for Ollama the pulled tag, e.g. qwen3:1.7b
LLM_MODE=extract           # refine | extract | full
LLM_TIMEOUT_SEC=120
LLM_MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf  # docker compose --profile llm: file in ./data/models

# --- auth
JWT_SECRET=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false        # true behind HTTPS
# First admin, created on startup if missing (use with SEED_DEMO=false in real deployments)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password of the demo users (aliya@ / erlan@ / aigerim@qadam.kz) when SEED_DEMO=true
DEMO_PASSWORD=qadam-demo

# --- misc
SEED_DEMO=true
DATABASE_URL=sqlite:///./data/qadam.db
RECORDINGS_DIR=./data/recordings
CORS_ORIGINS=http://localhost:5173
